<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- 顶部状态栏：今日日期与时间胶囊（对齐课表顶栏风格） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日日程"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_title"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_clock_bg"
            android:textColor="@color/widget_clock_text" />
    </LinearLayout>

    <!-- 焦点日程卡片：当前正在进行或即将开始的下一项（与课表 class-block 同款灰蓝半透卡片） -->
    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/widget_hero_bg"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/heroStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一节课"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_hero_status" />

                <TextView
                    android:id="@+id/heroClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="10:20–12:00"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroClassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="课程标题"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_loc_bg"
            android:textColor="@color/widget_hero_loc_text"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 多日程列表容器 -->
    <LinearLayout
        android:id="@+id/itemsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 条目 1 -->
        <LinearLayout
            android:id="@+id/itemRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="4.5dp"
            android:paddingBottom="4.5dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/itemTag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_class"
                android:textColor="@color/widget_tag_class_text"
                android:text="日程" />

            <TextView
                android:id="@+id/itemTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginLeft="6dp"
                android:text="14:00" />

            <TextView
                android:id="@+id/itemTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="6dp"
                android:text="日程标题" />

            <TextView
                android:id="@+id/itemLoc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_hero_status"
                android:singleLine="true"
                android:layout_marginLeft="5dp"
                android:text="地点" />
        </LinearLayout>

        <!-- 条目 2 -->
        <LinearLayout
            android:id="@+id/itemRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="4.5dp"
            android:paddingBottom="4.5dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/itemTag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_class"
                android:textColor="@color/widget_tag_class_text"
                android:text="日程" />

            <TextView
                android:id="@+id/itemTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginLeft="6dp"
                android:text="15:45" />

            <TextView
                android:id="@+id/itemTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="6dp"
                android:text="日程标题" />

            <TextView
                android:id="@+id/itemLoc2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_hero_status"
                android:singleLine="true"
                android:layout_marginLeft="5dp"
                android:text="地点" />
        </LinearLayout>

        <!-- 条目 3 -->
        <LinearLayout
            android:id="@+id/itemRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="4.5dp"
            android:paddingBottom="4.5dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/itemTag3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_todo"
                android:textColor="@color/widget_tag_todo_text"
                android:text="DDL" />

            <TextView
                android:id="@+id/itemTime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginLeft="6dp"
                android:text="21:00" />

            <TextView
                android:id="@+id/itemTitle3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="6dp"
                android:text="待办标题" />

            <TextView
                android:id="@+id/itemLoc3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_hero_status"
                android:singleLine="true"
                android:layout_marginLeft="5dp"
                android:text="地点" />
        </LinearLayout>

        <!-- 条目 4 -->
        <LinearLayout
            android:id="@+id/itemRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="4.5dp"
            android:paddingBottom="4.5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/itemTag4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_todo"
                android:textColor="@color/widget_tag_todo_text"
                android:text="DDL" />

            <TextView
                android:id="@+id/itemTime4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginLeft="6dp"
                android:text="23:59" />

            <TextView
                android:id="@+id/itemTitle4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="6dp"
                android:text="待办标题" />

            <TextView
                android:id="@+id/itemLoc4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_hero_status"
                android:singleLine="true"
                android:layout_marginLeft="5dp"
                android:text="地点" />
        </LinearLayout>

        <!-- 全天无安排或未登录提示 -->
        <TextView
            android:id="@+id/emptyNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="今天没有待办和课程，好好休息吧~"
            android:textSize="12sp"
            android:textColor="@color/widget_text_muted"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部状态指示与点击引导 -->
    <TextView
        android:id="@+id/widgetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击进入完整课表"
        android:textSize="10.5sp"
        android:textColor="@color/widget_text_muted"
        android:paddingTop="3dp"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
