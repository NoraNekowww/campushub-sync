<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CampusHub 今日日程"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />

        <TextView
            android:id="@+id/widgetClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#93c5fd" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/widget_hero_bg"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下一节课"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#60a5fa" />

            <TextView
                android:id="@+id/heroClassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无待上课程"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:singleLine="true" />

            <TextView
                android:id="@+id/heroClassTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天好好休息~"
                android:textSize="10sp"
                android:textColor="#94a3b8" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#bfdbfe"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击进入课表与待办详情"
        android:textSize="10sp"
        android:textColor="#64748b" />

</LinearLayout>
