# ---------------------------------------------------------------------------
# CampusHub Sync — environment template.  Copy to .env and edit:
#     cp .env.example .env && chmod 600 .env
# Never commit the real .env (it is listed in .gitignore).
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ general
APP_NAME=CampusHub Sync
DEBUG=false
DATA_DIR=./data
# DATABASE_URL is derived from DATA_DIR when unset
# DATABASE_URL=sqlite:////app/data/campushub.db
TIMEZONE=Asia/Shanghai

# ------------------------------------------------------- secrets (REQUIRED)
# Both are mandatory on a public host: without ADMIN_TOKEN every mutating
# endpoint is open; without SUBSCRIBE_TOKEN anybody can read your calendar.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-admin-token
SUBSCRIBE_TOKEN=change-me-subscribe-token

# Public origin used when building the subscription URL shown in the UI.
# Sub-path deployment on nzlab.online uses https://nzlab.online/schedule
PUBLIC_BASE_URL=https://schedule.nzlab.online

# Optional extra CORS origins (comma separated); same-origin deployments need none.
CORS_ORIGINS=

# -------------------------------------------------------------- sync engine
SYNC_INTERVAL_MINUTES=10
SYNC_ON_STARTUP=true
ENABLE_SCHEDULER=true
EVENT_RETENTION_DAYS=30
HORIZON_DAYS=120
# 待办快通道：只刷微软待办（不碰教务 CAS），让手机上的勾选很快回来。0 = 关。
# 别调太密 —— 一轮 = 每个清单一次 Graph 请求，密了会吃 429（限流后要等 Retry-After，反而更慢）。
MS_SYNC_INTERVAL_MINUTES=5
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
# Serverless smoke tests / UI work without network access:
DEMO_MODE=false

# ------------------------------------------------- accounts / access control
# Self-service accounts, enforced by the app (the login wall in the PWA and the
# account widget on the portal). A signed-in account may read; an admin-role
# account may also write, which is how the app is used from a phone without
# pasting ADMIN_TOKEN anywhere.
ENABLE_ACCOUNTS=true
# Registration needs a gate. Leave ALLOW_OPEN_REGISTRATION=false and share the
# invite code with the people you want to let in.
ALLOW_OPEN_REGISTRATION=false
REGISTRATION_INVITE_CODE=change-me-invite-code
# The very first account created becomes the admin.
FIRST_USER_IS_ADMIN=true
PASSWORD_MIN_LENGTH=8
SESSION_TTL_HOURS=336
SESSION_COOKIE_NAME=campushub_session
SESSION_COOKIE_PATH=/
# true only when served over HTTPS (it is, behind nginx)
SESSION_COOKIE_SECURE=true
# Leave empty: an HMAC key is generated once into DATA_DIR/session.secret (0600)
SESSION_SECRET=

# ---------------------------------------------------- credential vault (加密)
# Key that encrypts every credential the app keeps on users' behalf — 教务系统
# 密码、微北洋 token、微软 refresh token、邀请码 — at rest in the kv table.
# Envelope: Fernet (AES-128-CBC + HMAC-SHA256), key = HKDF-SHA256(CREDENTIAL_KEY).
# Leave empty: a key is generated once into DATA_DIR/credential.key (0600).
# Keep it stable and back it up: lose or change it and stored credentials become
# unreadable ([vault] key mismatch in the log) — users must re-enter them.
CREDENTIAL_KEY=

# --------------------------------------------------------- Microsoft To Do
# Azure app registration (public client + device code flow, or confidential
# client with a secret). Scopes are fixed by the connector: Tasks.ReadWrite
# offline_access.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_SCOPES=Tasks.ReadWrite offline_access
# empty = all lists; else comma separated list ids
MS_LIST_IDS=
MS_INCLUDE_COMPLETED=false
# 待办里勾掉的日程要能在客户端显示成「已划掉」⇒ 完成态也要回拉，
# 但只看最近这么多天动过的（全量完成态要翻很多页，且会被 Graph 限流）。
MS_COMPLETED_LOOKBACK_DAYS=14
# 清单可能十几个，每个一次 Graph 请求 —— 并发抓。超过 6 容易吃到 429。
MS_MAX_CONCURRENCY=6
MS_INCLUDE_UNDUE=false

# ------------------------------------------------- Tianjin University 课表
# TJU_MODE: disabled | ics | wepeiyang | imported | demo
#   imported = 课表由「设置 → 微北洋直连」在浏览器(校园网)里抓取后导入（推荐）
#   wepeiyang = 服务器直连开放平台；该接口只对校园网开放，校外必然失败
TJU_MODE=ics
TJU_API_BASE=https://api.twt.edu.cn
# 开放平台（课表接口，仅校园网可达）
TJU_OPEN_BASE=https://open.twt.edu.cn/api
TJU_LOGIN_PATH=/api/v1/auth/login
TJU_SCHEDULE_PATH=/api/v1/schedule
# Preferred: paste a captured micro-token (WePeiyang "Authorization" header)
TJU_ACCESS_TOKEN=
# Fallback credentials for the login simulation (store in the keyring if you can)
TJU_USERNAME=
TJU_PASSWORD=
# Static ICS fallback — relative paths resolve inside DATA_DIR
TJU_ICS_PATH=timetable.ics

# Semester anchor: the Monday of week 1. Get this wrong and every class date
# shifts; verify against the official 校历.
SEMESTER_NAME=2026 秋季学期
SEMESTER_START_DATE=2026-09-07
SEMESTER_TOTAL_WEEKS=16
SEMESTER_HOLIDAYS=2026-10-01,2026-10-02,2026-10-03
# Optional custom period slots: {"1": ["08:30", "10:05"], "2": ["10:25", "12:00"]}
PERIOD_TIMES_JSON=
